{
	"name": "arpc-popup-creator-features",
	"version": "1.0.0",
	"description": "ARPC Popup Creator features plugin packages",
	"main": "main.js",
	"scripts": {
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/arpc-popup-creator vendor/bin/phpunit",
		"plugin-check": "wp-env run cli wp plugin check arpc-popup-creator"
	},
	"keywords": [
