{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "arpc/social-proof",
	"version": "1.0.0",
	"title": "Popup Social Proof",
	"category": "widgets",
	"icon": "groups",
	"description": "Shows how many people subscribed through your popups in a recent time window.",
	"keywords": [ "popup", "social proof", "subscribers" ],
	"textdomain": "arpc-popup-creator",
	"attributes": {
		"hours": {
			"type": "number",
			"default": 24
		},
		"minCount": {
			"type": "number",
			"default": 1
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
